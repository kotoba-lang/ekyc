{:paths ["src"]
 :deps {
        ;; kotoba.io replaced clojure.java.io / java.io.File here (2026-09-24).
        ;; An explicit floor: the java.io.File method functions (exists?, file?,
        ;; parent-file, canonical-path, mkdirs, list-files ...) are in kotoba.io
        ;; from this sha, and tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/io {:git/sha "1b60ca825c1e705bd195f857ca4549133653a9f3"}
        ;; kotoba.lang.coll replaced clojure.set here (2026-09-24). An explicit
        ;; floor: kotoba.lang.coll carries clojure.set's union/intersection/
        ;; difference/map-invert from 0ffd5f6, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/coll {:git/sha "f74e248f0a07e8ae572885f50fab6bdb39dc24be"}
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn {:git/sha "79dba32c8892058842c57783f06a2dfe4601aeb0"}
       ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/identity {:git/sha "5cf94e38c816ced6857ef62de344f6adea9fc050"}
        io.github.kotoba-lang/html {:git/url "https://github.com/kotoba-lang/html.git"
         :git/sha "04606d97309fa377a20d18ee123e5db8f59ad127"}
        io.github.kotoba-lang/css  {:git/url "https://github.com/kotoba-lang/css.git"
         :git/sha "4654260a9b06e3c98bd6e02c877612c0a1f2d7a9"}}
 :aliases
 {:test {:extra-paths ["test" "kotoba"]
         ;; datascript/datascript is the real portable datascript.core
         ;; library (same .cljc source that also compiles to run in a
         ;; browser) -- test-only, so it does not become a runtime dep of
         ;; kotoba.ekyc.jurisdiction-graph itself (that namespace only
         ;; emits EDN; ANY Datalog engine, real Datomic included, can
         ;; consume it). Mirrors orgs/etzhayyim/global-energy-datoms'
         ;; deps.edn, this workspace's precedent for proving DataScript
         ;; compatibility via the JVM artifact.
         ;;
         ;; kotoba-lang/amu is TEST-ONLY for the parity gate: it provides
         ;; the compiler + KIR interpreter the parity test runs the guest
         ;; through. Pinned to the same sha com-cloudflare pins.
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}
                      datascript/datascript {:mvn/version "1.7.8"}
                      io.github.kotoba-lang/amu
                      {:git/url "https://github.com/kotoba-lang/amu.git"
                       :git/sha "b0095427fdc1b52153b285e6443591f2196c20a6"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
